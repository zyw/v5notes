<script setup lang="tsx">
    import { Button, Popconfirm, Divider } from 'ant-design-vue';
    import { jsonClone } from '@sa/utils';
    import { type TableDataWithIndex } from '@sa/hooks';
    import { fetchBatchDelete${BusinessName}, fetchGet${BusinessName}List } from '@/service/api/${moduleName}/${business__name}';
    import { useAppStore } from '@/store/modules/app';
    import { useAuth } from '@/hooks/business/auth';
    import { useTreeTable, useTreeTableOperate } from '@/hooks/common/tree-table';
    import { useDownload } from '@/hooks/business/download';
    import { $t } from '@/locales';
    import { DownOutlined, UpOutlined } from '@ant-design/icons-vue';

    defineOptions({
        name: '${BusinessName}List'
    });

    const appStore = useAppStore();
    const { download } = useDownload();
    const { hasAuth } = useAuth();

    const {
        columns,
        columnChecks,
        data,
        getData,
        loading,
        searchParams,
        resetSearchParams,
        expandedRowKeys,
        isCollapse,
        expandAll,
        collapseAll
    } = useTreeTable({
        apiFn: fetchGet${BusinessName}List,
        apiParams: {
            pageNum: 1,
            pageSize: 10,
            // if you want to use the searchParams in Form, you need to define the following properties, and the value is null
            // the value can not be undefined, otherwise the property in Form will not be reactive
            #foreach ($column in $columns)
                #if($column.query)
                        $column.fieldName: null#if($foreach.hasNext),#end
                #end
            #end
            params: {}
        },
        idField: '#foreach($column in $columns)#if($column.isPk == '1')$column.fieldName#end#end',
        #if(${treeParentCode} && ${treeParentCode} != 'parentId')
            parentIdField: '${treeParentCode}',
        #end
        columns: () => [
            {
                type: 'selection',
                align: 'center',
                width: 48
            },
            #foreach ($column in $columns)
                #if($column.list)
                    {
                        key: '$column.fieldName',
                        title: '$column.columnComment',
                        dataIndex: '$column.fieldName',
                        align: 'center',
                        minWidth: 120
                    },
                #end
            #end
            {
                key: 'operate',
                title: $t('common.operate'),
                align: 'center',
                width: 130,
                customRender: ({ record }) => {
                    const renderContent = () => {
                        const addBtn = () => {
                            if (!hasAuth('${moduleName}:${businessName}:add')) {
                                return null;
                            }
                            return (
                                <Button
                                    type="primary"
                                    ghost
                                    size="small"
                                    onClick={() => addInRow(record)}
                                >
                                    {$t('common.add')}
                                </Button>
                            );
                        };

                        const editBtn = () => {
                            if (!hasAuth('${moduleName}:${businessName}:edit')) {
                                return null;
                            }
                            return (
                                <Button
                                    type="primary"
                                    ghost
                                    size="small"
                                    onClick={() => edit(record)}
                                >
                                    {$t('common.edit')}
                                </Button>
                            );
                        };

                        const deleteBtn = () => {
                            if (!hasAuth('${moduleName}:${businessName}:remove')) {
                                return null;
                            }
                            return (
                                <Popconfirm
                                    title={$t('common.confirmDelete')}
                                    onConfirm={() => handleDelete(record.#foreach($column in $columns)#if($column.isPk == '1')$column.fieldName#end#end)}
                                >
                                    <Button danger size="small">
                                        {$t('common.delete')}
                                    </Button>
                                </Popconfirm>
                            );
                        };

                        const buttons = [];
                        if (hasAuth('${moduleName}:${businessName}:add')) buttons.push(addBtn());
                        if (hasAuth('${moduleName}:${businessName}:edit')) buttons.push(editBtn());
                        if (hasAuth('${moduleName}:${businessName}:remove')) buttons.push(deleteBtn());

                        return (
                            <>
                                {buttons.map((btn, index) => (
                                    <>
                                        {index !== 0 && <Divider type="vertical" />}
                                        {btn}
                                    </>
                                ))}
                            </>
                        );
                    };

                    return (
                        <div class="flex-center gap-8px">
                            {renderContent()}
                        </div>
                    );
                }
            }
        ]
    });

    const { drawerVisible, operateType, editingData, handleAdd, handleEdit, checkedRowKeys, rowSelection, onBatchDeleted, onDeleted } =
        useTreeTableOperate(data, getData);

    async function handleBatchDelete() {
        // request
        const { error } = await fetchBatchDelete${BusinessName}(checkedRowKeys.value);
        if (error) return;
        onBatchDeleted();
    }

    async function handleDelete(#foreach($column in $columns)#if($column.isPk == '1')$column.fieldName#end#end: CommonType.IdType) {
        // request
        const { error } = await fetchBatchDelete${BusinessName}([#foreach($column in $columns)#if($column.isPk == '1')$column.fieldName#end#end]);
        if (error) return;
        onDeleted();
    }

    function edit(row: TableDataWithIndex<Api.$ModuleName.${BusinessName}>) {
        handleEdit(row);
    }

    function addInRow(row: TableDataWithIndex<Api.$ModuleName.${BusinessName}>) {
        editingData.value = jsonClone(row);
        handleAdd();
    }

    function handleExport() {
        download('/${moduleName}/${businessName}/export', searchParams, `${functionName}_#[[${new Date().getTime()}]]#.xlsx`);
    }
</script>

<template>
    <div class="min-h-500px flex-col-stretch gap-16px overflow-hidden lt-sm:overflow-auto">
        <${BusinessName}Search v-model:model="searchParams" @reset="resetSearchParams" @search="getData" />
        <ACard
            title="${functionName}列表"
            :bordered="false"
            :body-style="{ flex: 1, overflow: 'hidden' }"
            class="flex-col-stretch sm:flex-1-hidden card-wrapper"
        >
            <template #extra>
                <TableHeaderOperation
                    v-model:columns="columnChecks"
                    :disabled-delete="checkedRowKeys.length === 0"
                    :loading="loading"
                    :show-add="hasAuth('${moduleName}:${businessName}:add')"
                    :show-delete="hasAuth('${moduleName}:${businessName}:remove')"
                    :show-export="false"
                    @add="handleAdd"
                    @delete="handleBatchDelete"
                    @export="handleExport"
                    @refresh="getData"
                >
                    <template #prefix>
                        <Button v-if="!isCollapse" :disabled="!data.length" size="small" @click="expandAll">
                            <DownOutlined />
                            全部展开
                        </Button>
                        <Button v-if="isCollapse" :disabled="!data.length" size="small" @click="collapseAll">
                            <UpOutlined />
                            全部收起
                        </Button>
                    </template>
                </TableHeaderOperation>
            </template>
            <ATable
                :columns="columns"
                :data-source="data"
                size="small"
                :row-selection="rowSelection"
                :expanded-row-keys="expandedRowKeys"
                :loading="loading"
                :row-key="row => row.#foreach($column in $columns)#if($column.isPk == '1')$column.fieldName#end#end"
                :pagination="false"
                class="h-full"
            />
            <${BusinessName}OperateDrawer
                v-model:visible="drawerVisible"
                :operate-type="operateType"
                :row-data="editingData"
                @submitted="getData"
            />
        </ACard>
    </div>
</template>

<style scoped></style>
