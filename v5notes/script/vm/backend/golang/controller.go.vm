// Find${ClassName} 用id查询${className}表
// @Tags ${ClassName}
// @Summary 用id查询${className}表
// @Security ApiKeyAuth
// @Accept application/json
// @Produce application/json
// @Param id query int true "用id查询${className}表"
// @Success 200 {object} response.Response{data=models.${ClassName},msg=string} "查询成功"
// @Router /${className}/find${ClassName}ById [get]
func (c *${ClassName}Ctr) Find${ClassName}ById(c *gin.Context) {
    // 创建业务用Context
    ctx := c.Request.Context()

    id := c.Query("id")
    ${className}, err := ${className}Service.Get${ClassName}(ctx, id)
    if err != nil {
        global.LOG.Error("查询失败!", zap.Error(err))
        response.FailWithMessage("查询失败:"+err.Error(), c)
        return
    }
    response.OkWithData(${className}, c)
}


// Get${ClassName}List 分页获取${className}表列表
// @Tags ${ClassName}
// @Summary 分页获取${className}表列表
// @Security ApiKeyAuth
// @Accept application/json
// @Produce application/json
// @Param data query ${packageName}.domain.bo.${ClassName}Search true "分页获取${className}表列表"
// @Success 200 {object} response.Response{data=response.PageResult,msg=string} "获取成功"
// @Router /${className}/get${ClassName}List [get]
func (c *${ClassName}Ctr) Get${ClassName}List(c *gin.Context) {
    // 创建业务用Context
    ctx := c.Request.Context()

    var pageInfo ${packageName}.domain.bo.${ClassName}Search
    err := c.ShouldBindQuery(&pageInfo)
    if err != nil {
        response.FailWithMessage(err.Error(), c)
        return
    }
    list, total, err := payWayService.GetPayWayInfoList(ctx, pageInfo)
    if err != nil {
        global.LOG.Error("获取失败!", zap.Error(err))
        response.FailWithMessage("获取失败:"+err.Error(), c)
        return
    }
    response.OkWithDetailed(response.PageResult{
        List:     list,
        Total:    total,
        Page:     pageInfo.Page,
        PageSize: pageInfo.PageSize,
    }, "获取成功", c)
}
