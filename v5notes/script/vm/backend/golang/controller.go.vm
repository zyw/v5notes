package controller

import (
    "github.com/gin-gonic/gin"
    "go.uber.org/zap"
    "${packageName}/global"
    "${packageName}/models/response"
    "${packageName}/models"
    "${packageName}/models/request"
)

type ${ClassName}Ctr struct{}

// Create${ClassName} 创建${className}表
// @Tags ${ClassName}
// @Summary 创建${className}表
// @Security ApiKeyAuth
// @Accept application/json
// @Produce application/json
// @Param data body models.${ClassName} true "创建${className}表"
// @Success 200 {object} response.Response{msg=string} "创建成功"
// @Router /${className}/create${ClassName} [post]
func (c *${ClassName}Ctr) Create${ClassName}(c *gin.Context) {
    // 创建业务用Context
    ctx := c.Request.Context()

    var ${className} models.${ClassName}
    err := c.ShouldBindJSON(&${className})
    if err != nil {
        response.FailWithMessage(err.Error(), c)
        return
    }
    err = ${className}Service.Create${ClassName}(ctx, &${className})
    if err != nil {
        global.LOG.Error("创建失败!", zap.Error(err))
        response.FailWithMessage("创建失败:"+err.Error(), c)
        return
    }
    response.OkWithMessage("创建成功", c)
}

// Delete${ClassName} 删除${className}表
// @Tags ${ClassName}
// @Summary 删除${className}表
// @Security ApiKeyAuth
// @Accept application/json
// @Produce application/json
// @Param data body models.${ClassName} true "删除${className}表"
// @Success 200 {object} response.Response{msg=string} "删除成功"
// @Router /${className}/delete${ClassName} [delete]
func (c *${ClassName}Ctr) Delete${ClassName}(c *gin.Context) {
    // 创建业务用Context
    ctx := c.Request.Context()

    id := c.Query("id")
    err := ${className}Service.Delete${ClassName}(ctx, id)
    if err != nil {
        global.LOG.Error("删除失败!", zap.Error(err))
        response.FailWithMessage("删除失败:"+err.Error(), c)
        return
    }
    response.OkWithMessage("删除成功", c)
}

// Delete${ClassName}ByIds 批量删除${className}表
// @Tags ${ClassName}
// @Summary 批量删除${className}表
// @Security ApiKeyAuth
// @Accept application/json
// @Produce application/json
// @Success 200 {object} response.Response{msg=string} "批量删除成功"
// @Router /${className}/delete${ClassName}ByIds [delete]
func (c *${ClassName}Ctr) Delete${ClassName}ByIds(c *gin.Context) {
    // 创建业务用Context
    ctx := c.Request.Context()

    ids := c.QueryArray("ids[]")
