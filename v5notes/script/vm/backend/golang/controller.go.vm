// @Accept application/json
// @Produce application/json
// @Param data body models.${ClassName} true "更新${className}表"
// @Success 200 {object} response.Response{msg=string} "更新成功"
// @Router /${className}/update${ClassName} [put]
func (c *${ClassName}Ctr) Update${ClassName}(c *gin.Context) {
