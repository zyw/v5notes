{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v5notes",
  "version": "0.1.0",
  "identifier": "xin.v5ai.v5notes.client2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "V5Notes云笔记",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMzNFOTBGQTlGQUU0OEM\nUldTTTVQcXBEK2t6Njgzc3d1MThLMUNNSVBxNmtCMTZ0UEtxeXZISmtFUHkzeCt0MTg0V1gycG0K",
      "endpoints": [
        "https://github.com/zyw/v5notes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
