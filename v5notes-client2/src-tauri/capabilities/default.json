{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, tray exit confirmation, window visibility and the native print dialog",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-hide",
    "core:webview:allow-print",
    "updater:default",
    "process:default"
  ]
}
