{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V5Notes Vault",
  "version": "2.1.0",
  "identifier": "xin.v5ai.v5notes.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "V5Notes Vault",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["v5notes-vault"]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklERTFSRGMxUkVVM09VRkJSVEpDT1RNS1VsZFRWRXMyTm1FMU1UTllSbU5GTmpWVmNEWmhRamxSTkRaQ1RUTjVZM1J3WkVSdFJ6Wm5WMGxzZDFaeWFuVlhZMGxDU0hwMWJtb0s=",
      "endpoints": [
        "https://github.com/zyw/v5notes/releases/latest/download/vault-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
