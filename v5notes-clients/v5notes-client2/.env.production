# 页面标题
VITE_APP_TITLE = V5Notes云笔记

# 生产环境配置
VITE_APP_ENV = 'production'

# Vite 开发服务端口（打包不使用；保留与开发配置字段对齐）
VITE_APP_PORT = 1420

# 官方服务器地址（设置页「官方服务器」使用，页面不渲染明文）
VITE_OFFICIAL_SERVER = 'https://v5notes-api.v5ai.xin'

# 笔记客户端 id（需与后端 oauth2 客户端配置一致）
VITE_CLIENT_ID = 'd9df3c0228c05e5c61db46348bcadf6e'

# 登录加密 RSA 公钥（与后端解密私钥对应；更换需前后端一同更换）
VITE_API_PUBLIC_KEY = ''
