# 示例 A：独立域名只挂落地页
server {
  listen 443 ssl http2;
  server_name oauth.example.com;

  # ssl_certificate     /path/to/fullchain.pem;
  # ssl_certificate_key /path/to/privkey.pem;

  root /var/www/v5notes-oauth-landing;
  index index.html;

  # OAuth redirect 通常不带尾斜杠，必须显式落到回调页
  location = /social-callback {
    try_files /social-callback/index.html =404;
  }

  location / {
    try_files $uri $uri/ =404;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
}

# 示例 B：与管理端同端口时（回调页 + 反代 admin）
# 回调页 URL 为 /social-callback（无尾斜杠）时，相对路径 ../assets/brand-icon.png
# 会解析为 /assets/brand-icon.png；若不单独放出，会被 location / 代理到 admin 导致破图。
server {
  listen 8083;

  location = /social-callback {
    root /mnt/v5notes-oauth-landing;
    try_files /social-callback/index.html =404;
  }

  # 精确匹配图标，避免抢走 admin 构建产物里的其它 /assets/*
  location = /assets/brand-icon.png {
    root /mnt/v5notes-oauth-landing;
  }

  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_pass http://v5notes2-admin/;
    proxy_connect_timeout 600;
    proxy_read_timeout 600;
    client_max_body_size 10000m;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
}
